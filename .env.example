# Application
NODE_ENV=development

# API (NestJS)
API_PORT=3001

# Web (Next.js)
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
# Development map style — replace before production launch
NEXT_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json

# PostgreSQL / PostGIS (Docker Compose)
POSTGRES_DB=fuelmap
POSTGRES_USER=fuelmap
POSTGRES_PASSWORD=change-me-in-local-env
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://fuelmap:change-me-in-local-env@localhost:5432/fuelmap

# Redis (Docker Compose)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Ingestion scheduler (disabled by default for local development)
INGESTION_SCHEDULER_ENABLED=false
INGESTION_RUN_ON_STARTUP=false
FRANCE_INGEST_CRON=*/10 * * * *
SPAIN_INGEST_CRON=*/10 * * * *

# Germany Tankerkönig / MTS-K (requires free API key from https://creativecommons.tankerkoenig.de)
TANKERKOENIG_API_KEY=
# TANKERKOENIG_BASE_URL=https://creativecommons.tankerkoenig.de/json
# Weekly nationwide station discovery (UTC)
GERMANY_STATIONS_INGEST_CRON=0 2 * * 0
# Daily price refresh for known station IDs (UTC; full refresh may take many hours at 1 req/min)
GERMANY_PRICES_INGEST_CRON=0 3 * * *
# Optional cap for live grid discovery during development/dry-run
# GERMANY_GRID_MAX_POINTS=3

# Austria E-Control Spritpreisrechner (on-demand location queries; no API key required)
# AUSTRIA_ECONTROL_BASE_URL=https://api.e-control.at/sprit/1.0
# AUSTRIA_CACHE_TTL_SECONDS=900

# Spain official fuel API (public, no auth required)
SPAIN_FUEL_API_URL=https://sedeaplicaciones.minetur.gob.es/ServiciosRESTCarburantes/PreciosCarburantes/EstacionesTerrestres/

# Routing (OSRM) — development/testing only when using a public demo endpoint
ROUTING_PROVIDER=osrm
# Example public-compatible endpoint for manual local verification only (not for production)
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_TIMEOUT_MS=10000
ROUTING_CACHE_TTL_SECONDS=600

# Geocoding (Nominatim) — development/testing only on public nominatim.openstreetmap.org
GEOCODING_PROVIDER=nominatim
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_TIMEOUT_MS=5000
NOMINATIM_MIN_INTERVAL_MS=1000
GEOCODING_CACHE_TTL_SECONDS=86400
# Optional contact email for Nominatim usage policy identification (do not commit private addresses)
# NOMINATIM_CONTACT_EMAIL=

# Auth / sessions
WEB_ORIGIN=http://localhost:3000
# AUTH_COOKIE_NAME=fuelmap_session
# AUTH_SESSION_TTL_SECONDS=2592000

# Photo evidence / OCR (local filesystem, no cloud APIs)
IMAGE_STORAGE_PATH=./data/uploads
OCR_PROVIDER=tesseract
OCR_MAX_CONCURRENCY=1
