# Production environment template — copy to .env.production and fill in values.
# Do NOT commit .env.production with real secrets.

# Domain / TLS (Caddy)
APP_DOMAIN=fuelmap.example
ACME_EMAIL=ops@example.com

# Runtime
NODE_ENV=production
APP_VERSION=0.0.1
# GIT_SHA=set-at-build-time

# PostgreSQL (internal Docker network)
POSTGRES_DB=fuelmap
POSTGRES_USER=fuelmap
POSTGRES_PASSWORD=change-me-strong-password
DATABASE_URL=postgresql://fuelmap:change-me-strong-password@postgres:5432/fuelmap

# Redis (internal Docker network; ephemeral cache/scheduler state)
REDIS_URL=redis://redis:6379

# API
API_PORT=3001
API_GLOBAL_PREFIX=api
TRUST_PROXY=true

# Web (build-time for NEXT_PUBLIC_* — rebuild web image if these change)
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json

# Auth / sessions (same-origin production — no WEB_ORIGIN/CORS needed)
# AUTH_COOKIE_NAME=fuelmap_session
# AUTH_SESSION_TTL_SECONDS=2592000

# Image storage (persisted via Docker volume)
IMAGE_STORAGE_PATH=/app/data/uploads

# OCR
OCR_PROVIDER=tesseract
OCR_MAX_CONCURRENCY=1

# Ingestion scheduler (enable only on the single API instance)
INGESTION_SCHEDULER_ENABLED=true
INGESTION_RUN_ON_STARTUP=false

# Provider schedules (UTC) — quote values so shell scripts can source this file safely
FRANCE_INGEST_CRON="*/15 * * * *"
SPAIN_INGEST_CRON="*/15 * * * *"
ITALY_INGEST_CRON="0 8 * * *"
SLOVENIA_INGEST_CRON="0 */2 * * *"
CROATIA_INGEST_CRON="0 */4 * * *"
GERMANY_STATIONS_INGEST_CRON="0 2 * * 0"
GERMANY_PRICES_INGEST_CRON="0 3 * * *"

# Germany (optional — ingestion skipped when unset)
TANKERKOENIG_API_KEY=

# Routing — NOT production-ready until a self-hosted or commercial OSRM endpoint is configured
ROUTING_PROVIDER=osrm
OSRM_BASE_URL=
OSRM_TIMEOUT_MS=10000
ROUTING_CACHE_TTL_SECONDS=600

# Geocoding — NOT production-ready on public Nominatim; configure self-hosted/commercial provider
GEOCODING_PROVIDER=nominatim
NOMINATIM_BASE_URL=
NOMINATIM_TIMEOUT_MS=5000
NOMINATIM_MIN_INTERVAL_MS=1000
GEOCODING_CACHE_TTL_SECONDS=86400
# NOMINATIM_CONTACT_EMAIL=

# Backup host path (used by scripts/backup-postgres.sh on the VPS host)
BACKUP_DIR=./backups/postgres
BACKUP_RETENTION_DAYS=14
