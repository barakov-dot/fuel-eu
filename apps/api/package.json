{
  "name": "@fuelmap/api",
  "version": "0.0.1",
  "description": "FuelMap Europe API",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:prod": "node dist/src/main.js",
    "db:migrate:prod": "node dist/src/database/run-migrate.js",
    "db:seed:prod": "node dist/src/database/seeds/run-reference.js",
    "ingest:prod": "node dist/src/ingestion/run-ingest.js",
    "cleanup:sessions:prod": "node dist/src/database/commands/cleanup-sessions.js",
    "cleanup:report-images:prod": "node dist/src/database/commands/cleanup-report-images.js",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "test:integration": "jest --config ./test/jest-integration.json --runInBand",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:status": "drizzle-kit check",
    "db:seed": "ts-node src/database/seeds/run-reference.ts",
    "db:seed:dev": "ts-node src/database/seeds/run-dev.ts",
    "ingest:france": "ts-node src/ingestion/run-france.ts",
    "ingest:france:dry-run": "ts-node src/ingestion/run-france.ts -- --dry-run",
    "ingest:spain": "ts-node src/ingestion/run-spain.ts",
    "ingest:spain:dry-run": "ts-node src/ingestion/run-spain.ts -- --dry-run",
    "ingest:germany": "ts-node src/ingestion/run-germany.ts",
    "ingest:germany:dry-run": "ts-node src/ingestion/run-germany.ts -- --dry-run",
    "ingest:austria": "ts-node src/ingestion/run-austria.ts",
    "ingest:austria:dry-run": "ts-node src/ingestion/run-austria.ts -- --dry-run",
    "ingest:italy": "ts-node src/ingestion/run-italy.ts",
    "ingest:italy:dry-run": "ts-node src/ingestion/run-italy.ts -- --dry-run",
    "ingest:slovenia": "ts-node src/ingestion/run-slovenia.ts",
    "ingest:slovenia:dry-run": "ts-node src/ingestion/run-slovenia.ts -- --dry-run",
    "ingest:croatia": "ts-node src/ingestion/run-croatia.ts",
    "ingest:croatia:dry-run": "ts-node src/ingestion/run-croatia.ts -- --dry-run",
    "ingest": "ts-node src/ingestion/run-ingest.ts",
    "cleanup:sessions": "ts-node src/database/commands/cleanup-sessions.ts",
    "cleanup:report-images": "ts-node src/database/commands/cleanup-report-images.ts",
    "cli:smoke": "ts-node src/cli/cli-smoke.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.5.0",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "cron": "^4.4.0",
    "decimal.js": "^10.6.0",
    "csv-parse": "^6.1.0",
    "dotenv": "^17.4.1",
    "drizzle-orm": "^0.44.5",
    "ioredis": "^5.7.0",
    "multer": "^2.0.2",
    "postgres": "^3.4.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.3",
    "tesseract.js": "^7.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cron": "^2.4.3",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "testPathIgnorePatterns": [
      ".*integration\\.spec\\.ts$"
    ],
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
